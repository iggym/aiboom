<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>
  :root {
    --ink: #14161a;
    --muted: #5c6470;
    --line: #e3e6ea;
    --bg: #ffffff;
    --accent: #4f46e5;
    --accent-soft: #eef2ff;
    --code-bg: #f6f8fa;
  }
  * { box-sizing: border-box; }
  html { font-size: 15px; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.55;
  }
  .page { max-width: 1080px; margin: 0 auto; padding: 48px 32px 96px; }
  header.hero {
    border-bottom: 3px solid var(--accent);
    padding-bottom: 20px;
    margin-bottom: 28px;
  }
  header.hero h1 { font-size: 2.1rem; margin: 0 0 8px; letter-spacing: -0.02em; }
  header.hero .sub { color: var(--muted); font-size: 1rem; }
  .badge {
    display: inline-block;
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  h2 {
    font-size: 1.3rem;
    margin-top: 2.2rem;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
    letter-spacing: -0.01em;
  }
  h3 { font-size: 1.05rem; margin-top: 1.6rem; }
  p { margin: 0.6rem 0; }
  a { color: var(--accent); }
  code {
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.08em 0.35em;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.86em;
  }
  pre.code {
    background: var(--code-bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
    overflow-x: auto;
    font-size: 0.84rem;
  }
  pre.code code { background: none; border: 0; padding: 0; }
  pre.mermaid { background: var(--code-bg); border: 1px solid var(--line); border-radius: 8px; padding: 14px; font-size: 0.82rem; overflow-x: auto; }
  blockquote {
    margin: 1rem 0;
    padding: 8px 16px;
    border-left: 4px solid var(--accent);
    background: var(--accent-soft);
    color: #333b4a;
    border-radius: 0 6px 6px 0;
  }
  .table-wrap { overflow-x: auto; margin: 1rem 0; }
  table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
  th, td { border: 1px solid var(--line); padding: 7px 10px; text-align: left; vertical-align: top; }
  th { background: #fafbfc; font-weight: 600; }
  tbody tr:nth-child(even) { background: #fcfcfd; }
  nav.toc {
    background: #fafbfc;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 22px;
    margin-bottom: 28px;
  }
  nav.toc h2 { border: 0; margin: 0 0 8px; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  nav.toc ul { list-style: none; margin: 0; padding: 0; columns: 2; }
  nav.toc li { margin: 2px 0; }
  nav.toc li.toc-l3 { padding-left: 14px; font-size: 0.92rem; }
  ul { padding-left: 1.3rem; }
  li.nested { list-style: circle; }
  hr { border: 0; border-top: 1px solid var(--line); margin: 2rem 0; }
  footer.provenance {
    margin-top: 3rem;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media print {
    html { font-size: 11.5pt; }
    .page { max-width: none; padding: 0; }
    nav.toc { break-after: page; }
    h2 { break-after: avoid; }
    table, pre, blockquote { break-inside: avoid; }
    a { color: var(--ink); text-decoration: none; }
    pre.mermaid { display: none; }
    @page { margin: 16mm; }
  }
</style>
</head>
<body>
<div class="page">
<header class="hero">
  <span class="badge">CycloneDX {{ spec_version }} · AI BOM</span>
  <h1>{{ system_name }}</h1>
  <div class="sub">{{ subtitle }}</div>
</header>
{{ toc }}
<main>
{{ body }}
</main>
<footer class="provenance">
  <p>Generated by {{ generator }} · digest <code>{{ digest }}</code> · rules <code>{{ rules_version }}</code></p>
  <p>{{ disclaimer }}</p>
</footer>
</div>
</body>
</html>
